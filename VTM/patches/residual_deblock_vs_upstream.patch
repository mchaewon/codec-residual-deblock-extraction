+// ★ 새로 추가할 함수들 ★
+void Picture::createResidualBuffer()
+{
+  if(!m_residualBuffer && cs)
+  {
+    m_residualBuffer = new PelStorage;
+    
+    const ChromaFormat chromaFmt = cs->area.chromaFormat;
+    const Size lumaSize = cs->area.Y().size();
+    
+    m_residualBuffer->create(chromaFmt, 
+                             Area(0, 0, lumaSize.width, lumaSize.height));
+  }
+}
+
+void Picture::clearResidualBuffer()
+{
+  if(m_residualBuffer)
+  {
+    // Y component
+    PelBuf bufY = m_residualBuffer->getBuf(COMPONENT_Y);
+    memset(bufY.buf, 0, sizeof(Pel) * bufY.stride * bufY.height);
+    
+    // Cb component
+    PelBuf bufCb = m_residualBuffer->getBuf(COMPONENT_Cb);
+    memset(bufCb.buf, 0, sizeof(Pel) * bufCb.stride * bufCb.height);
+    
+    // Cr component
+    PelBuf bufCr = m_residualBuffer->getBuf(COMPONENT_Cr);
+    memset(bufCr.buf, 0, sizeof(Pel) * bufCr.stride * bufCr.height);
+  }
+}
+
+void Picture::destroyResidualBuffer()
+{
+  if(m_residualBuffer)
+  {
+    m_residualBuffer->destroy();
+    delete m_residualBuffer;
+    m_residualBuffer = nullptr;
+  }
+}
