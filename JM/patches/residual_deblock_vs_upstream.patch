+/* residual/deblock 출력 폴더 생성: 상위 폴더가 없어도 만든다 (mkdir -p) */
+static void mkdir_recursive(const char *dir)
+{
+  char path[FILE_NAME_SIZE];
+  size_t i;
+  snprintf(path, sizeof(path), "%s", dir);
+  for (i = 1; path[i] != '\0'; i++)
+  {
+    if (path[i] == '/' || path[i] == '\\')
+    {
+      char c = path[i];
+      path[i] = '\0';
+#ifdef WIN32
+      _mkdir(path);
+#else
+      mkdir(path, 0755);
+#endif
+      path[i] = c;
+    }
+  }
+#ifdef WIN32
+  _mkdir(path);
+#else
+  mkdir(path, 0755);
+#endif
+}
