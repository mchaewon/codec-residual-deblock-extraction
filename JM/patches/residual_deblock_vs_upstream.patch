+static void save_residual_frame(const char *path, StorablePicture *p)
+{
+    FILE *fp = fopen(path, "wb");
+    int i, j;
+    if (!fp) return;
+
+    for (j = 0; j < p->size_y; j++)
+        for (i = 0; i < p->size_x; i++) {
+            int16_t v = (int16_t)p->imgY_res[j][i];
+            fwrite(&v, 2, 1, fp);
+        }
+    fclose(fp);
+}
