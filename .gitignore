# ==============================================================================
# codec_final  —  JM / HM / VTM : residual & blocking-artifact extraction
# Repo root = codec_final/   (JM/, HM/, VTM/, analysis/)
#
# NOTE) Nested ".git" folders (e.g. HM/.git) CANNOT be handled by .gitignore.
#       Remove or move them out of codec_final BEFORE `git add`,
#       otherwise git records each folder as an empty "embedded repository".
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Build outputs  (re-creatable with cmake / make — never commit)
#    Anchored per codec on purpose: cmake/CMakeBuild/bin/*.py (HM) and
#    JM/bin/*.cfg are real source/config files and must stay tracked.
# ------------------------------------------------------------------------------
/HM/build/
/HM/bin/
/HM/lib/
/VTM/build/
/VTM/bin/
/VTM/lib/
/JM/bin/ldecod*
/JM/bin/lencod*
**/obj/
**/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.pdb
*.ilk
*.out


# ------------------------------------------------------------------------------
# 2. Video / bitstream / extracted-data files  (huge, regenerated by the scripts)
# ------------------------------------------------------------------------------
*.yuv
*.y4m
*.bin
*.bit
*.hevc
*.h265
*.265
*.h264
*.264
*.avc
*.266
*.vvc
*.mp4
*.mkv
*.avi
*.mov
*.npy
*.npz

# dataset / compression-result folders (LLFF, Compressed/<dataset>/<codec>/<scene>/QP*/...)
**/Compressed/
/*/data/
/*/residual*/
/*/deblock*/
**/residual_*/
**/deblock_*/

# encoder/decoder logs
*.log
*_log.txt


# ------------------------------------------------------------------------------
# 3. Analysis outputs
#    Scripts write to analysis/outputs/ ; only curated figures used in the
#    README go to analysis/figures/ , and the two small sample arrays to
#    analysis/samples/ (see exceptions at the bottom).
# ------------------------------------------------------------------------------
/analysis/outputs/
deblock_diff_vis/
deblock_grad_lap_vis/
vis_residual_hf/
analysis_*/
diff_map_poc*.png
map_visualization*.png
freq_visualization*.png
residual_[0-9]*.png

# Original analysis folder that currently lives inside HM/.
# The cleaned-up copy lives in codec_final/analysis/ — do not upload it twice.
/HM/analysis/


# ------------------------------------------------------------------------------
# 4. Python / notebook
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/


# ------------------------------------------------------------------------------
# 5. Secrets / credentials
#    HM/cfg/keystore/{private,ca_priv}/*.key are the public JVET *example* keys
#    (SEI-signature test). They are not needed for residual/deblock extraction.
#    Delete the "*.key" / "*.pem" lines only if you want a byte-identical upstream cfg/.
# ------------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.token


# ------------------------------------------------------------------------------
# 6. IDE / OS / tool-local files
# ------------------------------------------------------------------------------
.vscode/
.vs/
.idea/
*.sdf
*.suo
*.user
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json


# ------------------------------------------------------------------------------
# 6b. Added after inspecting JM / VTM (2026-10-09)
# ------------------------------------------------------------------------------
# local archives (e.g. HM.zip backup at repo root)
*.zip
# per-codec local data folders used by jm.sh / vtm.sh (yuv, bitstreams, logs, qp json)
/JM/jm_data/
/VTM/vtm_data/
# binary rate-control dump written by lencod into the working directory
/JM/leakybucketparam.cfg
/JM/bin/leakybucketparam.cfg
# JM encoder/decoder statistics written into the working directory
/JM/bin/*.dat
/JM/bin/*.dec
/JM/bin/data*.txt
# extraction output written at the codec root by hm.sh / vtm.sh
/HM/Compressed/
/VTM/Compressed/

# ------------------------------------------------------------------------------
# 7. Exceptions (keep these tracked even though patterns above match them)
# ------------------------------------------------------------------------------
!/analysis/figures/
!/analysis/figures/**
!/analysis/samples/
!/analysis/samples/**
# upstream JM test inputs (QCIF, ~0.5 MB total) used by JM/cfg/encoder.cfg
!/JM/cfg/foreman_part_qcif*.yuv