+Void TComPic::createResidualBuffer()
+{
+  if(!m_pcPicYuvResidual)
+  {
+    m_pcPicYuvResidual = new TComPicYuv;
+    
+    const TComSPS &sps = *(getSlice(0)->getSPS());
+    const ChromaFormat chromaFormatIDC = sps.getChromaFormatIdc();
+    const Int iWidth = sps.getPicWidthInLumaSamples();
+    const Int iHeight = sps.getPicHeightInLumaSamples();
+    
+    m_pcPicYuvResidual->create(iWidth, 
+                                iHeight, 
+                                chromaFormatIDC,
+                                sps.getMaxCUWidth(), 
+                                sps.getMaxCUHeight(), 
+                                sps.getMaxTotalCUDepth(), 
+                                true);
+  }
+}
+Void TComPic::clearResidualBuffer()
+{
+  if(m_pcPicYuvResidual)
+  {
+
+    for(Int comp = 0; comp < getNumberValidComponents(); comp++)
+    {
+      ComponentID compID = ComponentID(comp);
+      Pel* pBuf = m_pcPicYuvResidual->getAddr(compID);
+      UInt size = m_pcPicYuvResidual->getStride(compID) 
+                * m_pcPicYuvResidual->getHeight(compID);
+      memset(pBuf, 0, sizeof(Pel) * size);
+    }
+  }
+}
+  
+Void TComPic::destroyResidualBuffer()
+{
+  if(m_pcPicYuvResidual)
+  {
+    m_pcPicYuvResidual->destroy();
+    delete m_pcPicYuvResidual;
+    m_pcPicYuvResidual = NULL;
+  }
+}
 //! \}
