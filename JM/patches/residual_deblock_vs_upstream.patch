+/* ===== YUV 프레임 저장 헬퍼 ===== */
+static void save_yuv_frame(const char *path, StorablePicture *p)
+{
+    FILE *fp = fopen(path, "wb");
+    int i, j;
+    if (!fp) return;
+
+    /* Y */
+    for (j = 0; j < p->size_y; j++)
+        for (i = 0; i < p->size_x; i++) {
+            unsigned char v = (unsigned char)iClip3(0, 255, (int)p->imgY[j][i]);
+            fwrite(&v, 1, 1, fp);
+        }
+    /* Cb */
+    if (p->chroma_format_idc != YUV400)
+        for (j = 0; j < p->size_y_cr; j++)
+            for (i = 0; i < p->size_x_cr; i++) {
+                unsigned char v = (unsigned char)iClip3(0, 255, (int)p->imgUV[0][j][i]);
+                fwrite(&v, 1, 1, fp);
+            }
+    /* Cr */
+    if (p->chroma_format_idc != YUV400)
+        for (j = 0; j < p->size_y_cr; j++)
+            for (i = 0; i < p->size_x_cr; i++) {
+                unsigned char v = (unsigned char)iClip3(0, 255, (int)p->imgUV[1][j][i]);
+                fwrite(&v, 1, 1, fp);
+            }
+    fclose(fp);
+}
+/* ===== Residual 프레임 저장 헬퍼 (Y채널만) ===== */
