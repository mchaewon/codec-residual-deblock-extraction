+
+void DeblockingFilter::saveYUVForDebug(CodingStructure& cs, const std::string& tag)
+{
+  if (m_deblockDir.empty()) return;
+  
+  const int poc = cs.slice->getPOC();
+  char pocStr[16];
+  snprintf(pocStr, sizeof(pocStr), "%04d", poc + 1);
+
+  std::string filename = m_deblockDir + "/" + tag + "/deblock_" + pocStr + ".yuv";
+  std::ofstream ofs(filename, std::ios::binary);
+  if (!ofs) { printf("[DBF] Failed to open: %s\n", filename.c_str()); return; }
+
+  const ComponentID comps[3] = { COMPONENT_Y, COMPONENT_Cb, COMPONENT_Cr };
+  for (int c = 0; c < getNumberValidComponents(cs.area.chromaFormat); c++)
+  {
+    const CPelBuf buf = cs.picture->getRecoBuf().get(comps[c]);
+    const Pel*    base   = buf.buf;
+    const int     width  = buf.width;
+    const int     height = buf.height;
+    const ptrdiff_t stride = buf.stride;
+
+    for (int y = 0; y < height; y++)
+    {
+      const Pel* row = base + y * stride;
+      for (int x = 0; x < width; x++)
+      {
+        uint8_t val = (uint8_t)Clip3(0, 255, (int)row[x]);  // 8bit로 변경
+        ofs.write(reinterpret_cast<const char*>(&val), sizeof(uint8_t));
+      }
+    }
+  }
+}
